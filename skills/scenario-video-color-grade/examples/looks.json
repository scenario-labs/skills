{
  "_readme": "Twelve tuned looks, a starting set for a soft, slightly desaturated source. Copy next to your clip as looks.json and re-run the still test. The two B&W + one color looks expect object masks in masks/ (see references/keying.md); the mask names and key values are examples to replace with your own.",
  "00_ungraded": {
    "name": "Ungraded",
    "settings": "original footage",
    "ops": []
  },
  "01_sunset_glow": {
    "name": "Sunset Glow",
    "ops": [
      {
        "op": "white_balance",
        "temp": 0.3,
        "tint": 0.03
      },
      {
        "op": "cdl",
        "offset": [-0.035, -0.035, -0.035]
      },
      {
        "op": "contrast",
        "amount": 0.55
      },
      {
        "op": "saturation",
        "amount": 1.25
      },
      {
        "op": "split_tone",
        "shadows": [0.02, 0.0, 0.03],
        "highlights": [0.12, 0.035, -0.075]
      },
      {
        "op": "highlight_rolloff",
        "knee": 0.85
      }
    ],
    "vignette": "PI/5",
    "settings": "warmth +30 · contrast +55 · warm glow",
    "halation": {
      "threshold": 0.62,
      "color": [1.0, 0.55, 0.2],
      "sigma": 24,
      "opacity": 0.35
    }
  },
