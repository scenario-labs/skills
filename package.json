{
  "name": "@scenario-labs/skills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "prepare": "husky",
    "validate": "pnpm style && pnpm format:check && pnpm skill-files && pnpm groupings && pnpm readme && pnpm spell && pnpm spec",
    "style": "./scripts/check-style.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skill-files": "./scripts/check-skill-files.sh",
    "groupings": "node ./scripts/check-groupings.mjs",
    "readme": "node ./scripts/check-readme.mjs",
    "spell": "./scripts/check-spelling.sh",
    "spec": "./scripts/validate-skills.sh",
    "test": "./scripts/test-skill-scripts.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.19.0",
    "vitest": "^4.1.10"
  }
}
